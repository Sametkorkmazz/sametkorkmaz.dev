---
type Props = {
  title: string;
  meta: string;
};

const { title, meta } = Astro.props;
---

<div class="border-b border-line py-5">
  <div
    class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between"
  >
    <h3 class="font-serif text-xl font-medium">{title}</h3>
    <p class="shrink-0 font-mono text-[13px] text-muted tabular-nums">{meta}</p>
  </div>
  <slot />
</div>
