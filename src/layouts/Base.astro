---
import { Font } from "astro:assets";
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
};
const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-plex-mono" preload />
  </head>
  <body class="bg-bg font-sans text-[17px] leading-[1.6] text-fg">
    <main class="mx-auto max-w-170 px-5 py-16 sm:px-6">
      <slot />
    </main>
  </body>
</html>
